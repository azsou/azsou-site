    {
      "t": "forum_replies",
      "n": "forum_replies_body_check",
      "def": "CHECK (((char_length(body) >= 1) AND (char_length(body) <= 2000)))",
      "valid": true
    },
    {
      "t": "forum_replies",
      "n": "forum_replies_pkey",
      "def": "PRIMARY KEY (id)",
      "valid": true
    },
    {
      "t": "forum_replies",
      "n": "forum_replies_thread_id_check",
      "def": "CHECK (((char_length(thread_id) >= 1) AND (char_length(thread_id) <= 60)))",
      "valid": true
    },
    {
      "t": "forum_replies",
      "n": "forum_replies_thread_id_shape",
      "def": "CHECK (((thread_id ~ '^[0-9a-fA-F-]{36}$'::text) OR (thread_id ~ '^t-[a-z0-9-]{1,58}$'::text))) NOT VALID",
      "valid": false
    },
    {
      "t": "forum_threads",
      "n": "forum_threads_author_fkey",
      "def": "FOREIGN KEY (author) REFERENCES profiles(id) ON DELETE CASCADE",
      "valid": true
    },
    {
      "t": "forum_threads",
      "n": "forum_threads_body_check",
      "def": "CHECK (((char_length(body) >= 1) AND (char_length(body) <= 4000)))",
      "valid": true
    },
    {
      "t": "forum_threads",
      "n": "forum_threads_cat_check",
      "def": "CHECK (((char_length(cat) >= 1) AND (char_length(cat) <= 20)))",
      "valid": true
    },
    {
      "t": "forum_threads",
      "n": "forum_threads_pkey",
      "def": "PRIMARY KEY (id)",
      "valid": true
    },
    {
      "t": "forum_threads",
      "n": "forum_threads_title_check",
      "def": "CHECK (((char_length(title) >= 1) AND (char_length(title) <= 120)))",
      "valid": true
    },
    {
      "t": "profiles",
      "n": "profiles_display_name_check",
      "def": "CHECK (((char_length(display_name) >= 1) AND (char_length(display_name) <= 40)))",
      "valid": true
    },
    {
      "t": "profiles",
      "n": "profiles_id_fkey",
      "def": "FOREIGN KEY (id) REFERENCES auth.users(id) ON DELETE CASCADE",
