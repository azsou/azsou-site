  "functions": [
    {
      "n": "admin_set_user",
      "args": "target uuid, new_role text, new_banned boolean",
      "ret": "void",
      "secdef": true,
      "vol": "v",
      "cfg": "{search_path=public}",
      "src": "begin\n  if not public.is_admin() then raise exception 'admin only'; end if;\n  if new_role not in ('user','admin') then raise exception 'bad role'; end if;\n  update public.profiles set role = new_role, banned = new_banned where id = target;\nend",
      "acl": "=X/postgres,anon=X/postgres,authenticated=X/postgres,postgres=X/postgres,service_role=X/postgres"
    },
    {
      "n": "can_write",
      "args": "",
      "ret": "boolean",
      "secdef": true,
      "vol": "s",
      "cfg": "{search_path=public}",
      "src": "select exists (select 1 from public.profiles\n                 where id = auth.uid() and not banned)",
      "acl": "=X/postgres,anon=X/postgres,authenticated=X/postgres,postgres=X/postgres,service_role=X/postgres"
    },
    {
      "n": "handle_new_user",
      "args": "",
      "ret": "trigger",
      "secdef": true,
      "vol": "v",
      "cfg": "{search_path=public}",
      "src": "begin\n  insert into public.profiles (id, display_name)\n  values (new.id,\n          coalesce(nullif(trim(new.raw_user_meta_data->>'name'), ''),\n                   split_part(new.email, '@', 1)));\n  return new;\nend",
      "acl": "=X/postgres,anon=X/postgres,authenticated=X/postgres,postgres=X/postgres,service_role=X/postgres"
    },
    {
      "n": "is_admin",
      "args": "",
      "ret": "boolean",
      "secdef": true,
      "vol": "s",
      "cfg": "{search_path=public}",
      "src": "select exists (select 1 from public.profiles\n                 where id = auth.uid() and role = 'admin' and not banned)",
      "acl": "=X/postgres,anon=X/postgres,authenticated=X/postgres,postgres=X/postgres,service_role=X/postgres"
    }
  ],
