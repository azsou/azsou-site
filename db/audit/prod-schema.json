  "constraints": [
    {
      "t": "comments",
      "n": "comments_author_fkey",
      "def": "FOREIGN KEY (author) REFERENCES profiles(id) ON DELETE CASCADE",
      "valid": true
    },
    {
      "t": "comments",
      "n": "comments_body_check",
      "def": "CHECK (((char_length(body) >= 1) AND (char_length(body) <= 600)))",
      "valid": true
    },
    {
      "t": "comments",
      "n": "comments_page_key_check",
      "def": "CHECK ((page_key ~ '^(article|game|work|project):[a-z0-9-]{1,60}$'::text))",
      "valid": true
    },
    {
      "t": "comments",
      "n": "comments_pkey",
      "def": "PRIMARY KEY (id)",
      "valid": true
    },
    {
      "t": "forum_replies",
