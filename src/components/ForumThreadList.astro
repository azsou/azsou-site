---
import '@/styles/community.css';
import { forum } from '@/lib/content';
import { url } from '@/lib/routes';
interface Props {
  category?: string;
}
const { category } = Astro.props;
const catName = Object.fromEntries(forum.categories.map((c) => [c.id, c.name]));
const seeds = forum.seeds
  .filter((t) => !category || t.category === category)
  .sort((a, b) => Number(b.pinned) - Number(a.pinned) || b.date.localeCompare(a.date));
const hid = `h-community-${category ?? 'all'}`;
// /forum/ 上本组件位于「全部主题」h2 之下；分类页直接接在 h1 后
const H = category ? 'h2' : 'h3';
---

<section data-forum-list data-category={category ?? ''} aria-label="主题列表">
  {seeds.length > 0 && (
    <ul class="list-group" role="list" aria-label="站点主题" data-list>
      {seeds.map((t) => (
        <li data-seed-id={t.id} data-seed-replies={t.replies.length}>
          <a class="list-row" href={url.forumThread(t.id)}>
            <span class="list-row__main">
              <span class="list-row__title">
                {t.pinned && <span class="badge">置顶</span>} {t.title}
              </span>
              <br />
              <span class="list-row__sub">
                {catName[t.category]} · {t.author} · {t.date}
              </span>
            </span>
            <span class="list-row__aside">{t.replies.length} 回复</span>
          </a>
        </li>
      ))}
    </ul>
  )}
  <H class="list-heading" id={hid}>
    社区主题
  </H>
  <ul class="list-group" role="list" aria-labelledby={hid} aria-busy="true" data-db-list>
    {[0, 1, 2].map(() => (
      <li class="skeleton-row" aria-hidden="true">
        <span class="skeleton skeleton--line" />
        <span class="skeleton skeleton--line skeleton--short" />
      </li>
    ))}
  </ul>
  <div class="btn-row list-more">
    <button class="btn" type="button" data-more hidden>
      加载更多
    </button>
  </div>
  <p class="data-status" data-status role="status">
    正在加载社区主题…
  </p>
</section>

<script>
  import { whenIdle } from '@/scripts/idle';
  whenIdle(() => import('@/scripts/community/forum-list'));
</script>
