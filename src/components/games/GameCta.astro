---
/**
 * 游戏详情首屏主操作（T9.12，DESIGN-SYSTEM §10 / §16）：状态驱动，只画一个可用主按钮，不画禁用按钮。
 *  - 有 playUrl → 「试玩」（主）；同时有 demoVideo → 「观看演示」（次）；
 *  - 只有 demoVideo → 「观看演示」（主，链到本站视频详情）；
 *  - 都没有 → 「上线时通知我」（主，进订阅页）。
 */
import Icon from '@/components/Icon.astro';
import { url } from '@/lib/routes';
interface Props {
  playUrl?: string;
  demoVideo?: string;
  en?: boolean;
}
const { playUrl, demoVideo, en = false } = Astro.props;
const ext = playUrl?.startsWith('https://') ?? false;
const t = en
  ? { play: 'Play the demo', demo: 'Watch the demo', notify: 'Notify me at launch' }
  : { play: '试玩', demo: '观看演示', notify: '上线时通知我' };
const demoHref = demoVideo ? url.video(demoVideo) : undefined;
---

<div class="game-cta" data-game-cta>
  {playUrl && (
    <a class="btn btn--primary" href={playUrl} data-primary-cta rel={ext ? 'noopener' : undefined}>
      <Icon name="play" size={20} />
      {t.play}
      {ext && <Icon name="arrow-up-right" size={16} class="icon--trail" />}
    </a>
  )}
  {demoHref && (
    <a
      class:list={['btn', { 'btn--primary': !playUrl }]}
      href={demoHref}
      data-primary-cta={playUrl ? undefined : ''}
    >
      <Icon name="play" size={20} />
      {t.demo}
    </a>
  )}
  {!playUrl && !demoHref && (
    <a class="btn btn--primary" href={en ? '/en/subscribe/' : '/subscribe/'} data-primary-cta data-notify>
      <Icon name="bell" size={20} />
      {t.notify}
    </a>
  )}
</div>
