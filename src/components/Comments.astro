---
import { formatDate } from '@/lib/dates';
import '@/styles/community.css';
import seedsData from '@/data/comment-seeds.json';
import { initials } from '@/scripts/render';
import { textToHtml } from '@/lib/escape';
interface Props {
  /** 与 V72 一致的 page_key：article:<slug> / game:<slug> / work:<slug> / project:<slug> */
  pageKey: string;
  title?: string;
}
type Seed = { author: string; date: string; body: string; site: boolean };
const { pageKey, title = '讨论' } = Astro.props;
const scope = pageKey.split(':')[0];
const all = seedsData as Record<string, Seed[]>;
const seeds = [...(all[`${scope}:*`] ?? []), ...(all[pageKey] ?? [])];
const id = `discussion-${pageKey.replace(/[^a-z0-9]+/gi, '-')}`;
---

<section
  class="discussion panel"
  data-pagefind-ignore
  data-comments
  data-page-key={pageKey}
  aria-labelledby={id}
>
  <div class="section__head">
    <h2 id={id}>{title}</h2>
    <span class="muted" data-count>
      {seeds.length} 条
    </span>
  </div>
  <p class="muted">评论公开可见，支持 Markdown。后端不可达时本区自动进入只读模式。</p>
  <ul class="list-reset" role="list" data-list>
    {seeds.map((c) => (
      <li class="comment" data-source="seed">
        <span class="avatar" aria-hidden="true">
          {initials(c.author)}
        </span>
        <div>
          <div class="comment__head">
            <b>{c.author}</b>
            {c.site && <span class="badge">作者</span>}
            <time datetime={c.date}>{formatDate(c.date)}</time>
          </div>
          <div class="comment__body" set:html={textToHtml(c.body)} />
        </div>
      </li>
    ))}
  </ul>
  <div class="composer-box" data-composer></div>
  <p class="data-status" data-status role="status">
    正在加载讨论…
  </p>
</section>

<script>
  import { whenIdle, whenNear } from '@/scripts/idle';
  // 讨论区在页面底部：页面空闲后开始观察，接近视口时才加载
  whenIdle(() => {
    const box = document.querySelector('[data-comments]');
    if (box) whenNear(box, () => import('@/scripts/community/comments'));
  });
</script>
