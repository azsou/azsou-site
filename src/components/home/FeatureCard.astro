---
import AppIcon from '@/components/apps/AppIcon.astro';
import Icon from '@/components/Icon.astro';
import type { FeaturedItem } from '@/lib/home';
/** 编辑精选大卡片（App Store「Today」式）：只显示档案里的真实字段，没有评分 / 下载数 */
interface Props {
  item: FeaturedItem;
  /** 首屏内的卡片传 true：图标 eager + 同步解码（DESIGN-SYSTEM §19.3） */
  eager?: boolean;
}
const { item, eager = false } = Astro.props;
---

<article class="feature-card" data-hue={item.hue} data-featured={item.slug}>
  <p class="feature-card__eyebrow">{item.label}</p>
  <div class="feature-card__head">
    <AppIcon src={item.icon.src} alt="" variants={item.icon.variants} size="lg" eager={eager} />
    <div class="feature-card__titles">
      <h3 class="feature-card__title">
        <a class="card__link" href={item.url}>
          {item.title}
        </a>
      </h3>
      <p class="feature-card__sub">{item.subtitle}</p>
    </div>
  </div>
  <p class="feature-card__summary">{item.summary}</p>
  <p class="feature-card__foot">
    <span class="feature-card__platforms">
      {item.platforms.length > 3
        ? `${item.platforms.slice(0, 2).join(' · ')} 等 ${item.platforms.length} 个平台`
        : item.platforms.join(' · ')}
    </span>
    <span class="btn btn--primary btn--sm feature-card__cta" aria-hidden="true">
      {item.kind === 'tool' ? '了解工具' : '查看应用'}
      <Icon name="chevron-right" size={16} />
    </span>
  </p>
</article>
