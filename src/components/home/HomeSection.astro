---
import Icon from '@/components/Icon.astro';
/**
 * 首页区块：标题 + 说明 + 「更多」链接；row 时正文是横向滚动行（scroll-snap），标题行右侧带上一组 / 下一组按钮。
 * 按钮默认 hidden，由 src/scripts/home/rows.ts 在内容确实溢出时显示（没有 JS 时仍可原生横向滚动 / 键盘滚动）。
 * 区块是否渲染由首页按 homeSections() 决定——这里不处理「空」的情况。
 */
interface Props {
  id: string;
  title: string;
  /** 排序 / 数据来源的如实说明（如「按编辑推荐顺序」） */
  note?: string;
  more?: { href: string; label: string };
  row?: 'feature' | 'tile' | 'grid3' | 'card' | 'video' | 'article';
  class?: string;
}
const { id, title, note, more, row, class: cls = '' } = Astro.props;
const headingId = `h-${id}`;
const trackId = `row-${id}`;
---

<section class={`section home-sec ${cls}`} aria-labelledby={headingId} data-section={id}>
  <div class="section__head home-sec__head">
    <div class="home-sec__titles">
      <h2 id={headingId}>{title}</h2>
      {note && <p class="home-sec__note">{note}</p>}
    </div>
    <div class="home-sec__actions">
      {more && (
        <a href={more.href}>
          {more.label} <Icon name="chevron-right" size={16} class="icon--trail" />
        </a>
      )}
      {row && (
        <div class="srow-ctl" data-srow-ctl hidden>
          <button
            type="button"
            class="icon-btn srow-ctl__btn"
            data-dir="-1"
            aria-controls={trackId}
            aria-label={`上一组：${title}`}
          >
            <Icon name="chevron-left" />
          </button>
          <button
            type="button"
            class="icon-btn srow-ctl__btn"
            data-dir="1"
            aria-controls={trackId}
            aria-label={`下一组：${title}`}
          >
            <Icon name="chevron-right" />
          </button>
        </div>
      )}
    </div>
  </div>
  {row ? (
    <ul id={trackId} class={`srow srow--${row}`} role="list" tabindex="0" aria-label={title} data-srow>
      <slot />
    </ul>
  ) : (
    <slot />
  )}
</section>
