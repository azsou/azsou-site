---
import AppIcon from '@/components/apps/AppIcon.astro';
import type { Hue } from '@/lib/hue';
/** 横向行里的紧凑应用 / 工具条目（图标 + 名称 + 副标题 + 一行元信息） */
interface Props {
  title: string;
  subtitle: string;
  meta: string;
  href: string;
  icon: { src: string; variants: boolean };
  slug: string;
  /** 色相：悬停时图标背后的柔光 */
  hue?: Hue;
  /** 首屏内的卡片传 true：图标 eager + 同步解码（DESIGN-SYSTEM §19.3） */
  eager?: boolean;
}
const { title, subtitle, meta, href, icon, slug, hue, eager = false } = Astro.props;
---

<article class="app-tile" data-tile={slug} data-hue={hue}>
  <AppIcon src={icon.src} alt="" variants={icon.variants} eager={eager} />
  <div class="app-tile__body">
    <h3 class="app-tile__title">
      <a class="card__link" href={href}>
        {title}
      </a>
    </h3>
    <p class="app-tile__sub">{subtitle}</p>
    <p class="app-tile__meta">{meta}</p>
  </div>
</article>
