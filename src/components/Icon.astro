---
/**
 * UI 图标（DESIGN-SYSTEM §17）：Lucide 子集，24 网格、描边 1.75、round 端点、currentColor。
 * 尺寸只允许 16 / 20 / 24；不传 size 时由父级 CSS 决定（如 .icon-btn svg）。
 * 品牌图标（github）是填充字标，标记 data-icon-variant="filled"。
 */
import { LUCIDE, type IconName } from '@/lib/lucide';
interface Props {
  name: IconName;
  label?: string;
  size?: 16 | 20 | 24;
  class?: string;
}
const { name, label, size, class: cls } = Astro.props;
const GITHUB =
  '<path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.56 9.56 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2z"/>';
const filled = name === 'github';
const body = filled ? GITHUB : LUCIDE[name as keyof typeof LUCIDE];
---

<svg
  class:list={['icon', size && `icon--${size}`, cls]}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? undefined : 'currentColor'}
  stroke-width={filled ? undefined : '1.75'}
  stroke-linecap={filled ? undefined : 'round'}
  stroke-linejoin={filled ? undefined : 'round'}
  data-icon-variant={filled ? 'filled' : undefined}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={body}
/>
