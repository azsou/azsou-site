---
import { FOOTER, SITE } from '@/lib/site';
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/"><span class="brand__mark" aria-hidden="true">AZ</span>AZ Studio</a>
        <p>个人技术社区、产品档案与创作实验室。内容来自真实项目，不伪造评分、下载量、用户数或评论。</p>
        <ul class="trust-points" aria-label="内容原则">
          <li class="badge">真实项目</li><li class="badge">版本记录</li><li class="badge">测试环境</li><li class="badge">最后核对</li>
        </ul>
      </div>
      {
        FOOTER.map((col) => (
          <div>
            <h2>{col.title}</h2>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="footer-bottom">
      <span>© 2026 {SITE.name} · {SITE.author.name}</span>
      <span>Astro 静态构建 · 中文</span>
    </div>
  </div>
</footer>
