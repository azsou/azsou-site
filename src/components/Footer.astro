---
import { FOOTER, SITE } from '@/lib/site';
import { EN_FOOTER } from '@/lib/i18n-labels';
import type { Lang } from '@/lib/i18n';
import SocialLinks from './SocialLinks.astro';
interface Props {
  lang?: Lang;
  switchHref?: string;
}
const { lang = 'zh', switchHref = lang === 'en' ? '/' : '/en/' } = Astro.props;
const en = lang === 'en';
const cols = en ? EN_FOOTER : FOOTER;
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-grid">
      <div>
        <a class="brand" href={en ? '/en/' : '/'}>
          <span class="brand__mark" aria-hidden="true">
            AZ
          </span>
          AZ Studio
        </a>
        {en ? (
          <p>
            Randy Hopkins’s personal studio: the apps and games he builds, hands-on notes on AI tools, dev
            articles and a forum. Most long-form writing is in Chinese.
          </p>
        ) : (
          <p>
            Randy Hopkins 的个人工作室：他做的应用和游戏、AI 工具上手笔记、开发文章，还有一个可以交流的论坛。
          </p>
        )}
        <SocialLinks lang={lang} />
      </div>
      {cols.map((col) => (
        <div>
          <h2>{col.title}</h2>
          <ul>
            {col.links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="footer-bottom">
      <span>
        © 2026 {SITE.name} · {SITE.author.name}
      </span>
      <span>
        <a href={switchHref} hreflang={en ? 'zh-CN' : 'en'} lang={en ? 'zh-CN' : 'en'}>
          {en ? '中文' : 'English'}
        </a>
      </span>
    </div>
  </div>
</footer>
