---
/** 英文版应用 / AI 工具卡片（T7.6），与中文卡片同一套样式 */
import AppIcon from '@/components/apps/AppIcon.astro';
interface Props {
  href: string;
  title: string;
  subtitle: string;
  meta: string;
  icon: { src: string; variants: boolean };
  hue: string;
  headingLevel?: 'h2' | 'h3';
  /** 首屏内的卡片传 true：图标 eager + 同步解码（DESIGN-SYSTEM §19.3） */
  eager?: boolean;
}
const { href, title, subtitle, meta, icon, hue, headingLevel = 'h2', eager = false } = Astro.props;
const H = headingLevel;
---

<article class="card card--row card--hue app-card" data-hue={hue}>
  <AppIcon src={icon.src} alt="" variants={icon.variants} eager={eager} />
  <div class="card__body">
    <H class="card__title">
      <a class="card__link" href={href}>
        {title}
      </a>
    </H>
    <p class="card__text">{subtitle}</p>
    <p class="card__meta">{meta}</p>
  </div>
</article>
