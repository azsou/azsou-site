---
import { NAV } from '@/lib/site';
import Icon from './Icon.astro';
import UserMenu from './UserMenu.astro';
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-nav glass">
  <nav class="shell site-nav__inner" aria-label="主导航">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true">
        AZ
      </span>
      <span>AZ Studio</span>
    </a>
    <ul class="nav-links">
      {NAV.map((n) => (
        <li>
          <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>
            {n.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="nav-actions">
      <a
        class="icon-btn"
        href="/search/"
        aria-label="搜索（Ctrl K）"
        aria-keyshortcuts="Control+K Meta+K"
        aria-current={path.startsWith('/search/') ? 'page' : undefined}
        data-palette-open
      >
        <Icon name="search" />
      </a>
      <button class="icon-btn theme-btn" type="button" aria-label="外观：跟随系统" data-theme-toggle>
        <svg class="theme-btn__icon theme-btn__icon--system" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zm0 2v14a7 7 0 0 1 0-14z"></path>
        </svg>
        <svg class="theme-btn__icon theme-btn__icon--light" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm-1-5h2v3h-2zm0 17h2v3h-2zM2 11h3v2H2zm17 0h3v2h-3zM4.2 5.6l1.4-1.4 2.1 2.1-1.4 1.4zm12.1 12.1 1.4-1.4 2.1 2.1-1.4 1.4zM4.2 18.4l2.1-2.1 1.4 1.4-2.1 2.1zM16.3 6.3l2.1-2.1 1.4 1.4-2.1 2.1z"
          ></path>
        </svg>
        <svg class="theme-btn__icon theme-btn__icon--dark" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M14.5 2.5a9.5 9.5 0 1 0 7 15.9A8 8 0 0 1 14.5 2.5z"></path>
        </svg>
      </button>
      <UserMenu />
    </div>
  </nav>
</header>
