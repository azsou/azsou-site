---
import AppIcon from '@/components/apps/AppIcon.astro';
import { AI_CATEGORIES, PLATFORM_LABEL, type ToolItem } from '@/lib/app-store';
/**
 * /ai/ 瀑布流卡片。data-* 给客户端筛选用（src/scripts/ai/filter.ts），隐藏用 hidden 属性，不重新渲染。
 */
interface Props {
  item: ToolItem;
  headingLevel?: 'h2' | 'h3';
}
const { item, headingLevel = 'h2' } = Astro.props;
const H = headingLevel;
---

<article
  class="card card--hue tool-card"
  data-hue={item.hue}
  data-tool={item.slug}
  data-cats={item.categories.join(' ')}
  data-price={item.price}
  data-oss={item.openSource ? '1' : '0'}
>
  <div class="tool-card__head">
    <AppIcon src={item.iconSrc} alt={item.iconAlt} variants={item.iconVariants} />
    <div>
      <H class="card__title">
        <a class="card__link" href={item.url}>
          {item.title}
        </a>
      </H>
      <p class="tool-card__dev">{item.developer}</p>
    </div>
  </div>
  <p class="card__text tool-card__summary">{item.summary}</p>
  <ul class="tool-card__tags" role="list">
    {item.categories.map((c) => (
      <li class="tag">{AI_CATEGORIES[c]}</li>
    ))}
  </ul>
  <p class="tool-card__meta">
    <span>{item.priceLabel}</span>
    {item.openSource && <span class="badge">开源</span>}
    <span class="tool-card__platforms">{item.platforms.map((p) => PLATFORM_LABEL[p]).join(' · ')}</span>
  </p>
</article>
