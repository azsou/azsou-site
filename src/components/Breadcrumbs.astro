---
import type { Crumb } from '@/lib/seo';
interface Props {
  items: Crumb[];
  lang?: 'zh' | 'en';
}
const { items, lang = 'zh' } = Astro.props;
---

<nav class="crumbs" aria-label={lang === 'en' ? 'Breadcrumb' : '面包屑'} data-pagefind-ignore>
  <ol>
    {items.map((c, i) => (
      <li>
        {i === items.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.path}>{c.name}</a>}
      </li>
    ))}
  </ol>
</nav>
