---
/**
 * 详情页导流区（P10 T10.13）：同类替代 / 同开发者 / 编辑推荐 / 相关文章。
 * ≥ 1200 是右侧栏，窄屏堆叠在正文之后；条目复用 Shelf（stack 竖排）+ AppMini。没有条目的组整组不渲染。
 */
import Shelf from '@/components/store/Shelf.astro';
import AppMini from '@/components/store/AppMini.astro';
import type { StoreEntry } from '@/lib/store';

export interface SideGroup {
  id: string;
  title: string;
  note?: string;
  more?: { href: string; label?: string };
  entries: StoreEntry[];
}
interface Props {
  label: string;
  groups: SideGroup[];
  articles?: { title: string; href: string; meta?: string }[];
}
const { label, groups, articles = [] } = Astro.props;
const shown = groups.filter((g) => g.entries.length > 0);
/** 侧栏前 6 个条目在 1440×900 首屏内：图标 eager（priority 关，不抢 LCP） */
const EAGER = 6;
const offset = shown.map((_, i) => shown.slice(0, i).reduce((n, g) => n + g.entries.length, 0));
---

{(shown.length > 0 || articles.length > 0) && (
  <aside class="detail-side" aria-label={label} data-detail-side data-pagefind-ignore>
    {shown.map((g, gi) => (
      <Shelf id={g.id} title={g.title} note={g.note} more={g.more} kind="stack">
        {g.entries.map((e, i) => (
          <li>
            <AppMini entry={e} eager={offset[gi] + i < EAGER} />
          </li>
        ))}
      </Shelf>
    ))}
    {articles.length > 0 && (
      <section class="section shelf" aria-labelledby="h-articles" data-section="articles">
        <div class="section__head shelf__head">
          <h2 id="h-articles">相关文章</h2>
        </div>
        <ul class="detail-articles" role="list">
          {articles.map((a) => (
            <li>
              <a href={a.href}>
                {a.title}
                {a.meta && <small>{a.meta}</small>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </aside>
)}
