---
interface Props {
  label: string;
  items: { href: string; label: string; current?: boolean }[];
}
const { label, items } = Astro.props;
---

<nav class="segmented" aria-label={label}>
  {items.map((i) => (
    <a href={i.href} aria-current={i.current ? 'page' : undefined}>
      {i.label}
    </a>
  ))}
</nav>
