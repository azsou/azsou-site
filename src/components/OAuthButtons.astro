---
import Icon from './Icon.astro';
interface Props {
  verb?: string;
}
const { verb = '登录' } = Astro.props;
---

<div class="oauth-list" data-oauth-list>
  <button type="button" class="btn btn--oauth btn--block" data-oauth="github">
    <Icon name="github" />
    使用 GitHub {verb}
  </button>
  <button type="button" class="btn btn--oauth btn--block" data-oauth="google">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path
        fill="#4285F4"
        d="M23.5 12.27c0-.85-.08-1.67-.22-2.45H12v4.64h6.45a5.5 5.5 0 0 1-2.39 3.62v3h3.86c2.26-2.08 3.58-5.15 3.58-8.81z"
      ></path>
      <path
        fill="#34A853"
        d="M12 24c3.24 0 5.95-1.07 7.93-2.9l-3.86-3c-1.08.72-2.45 1.15-4.07 1.15-3.13 0-5.78-2.11-6.73-4.95H1.28v3.1A12 12 0 0 0 12 24z"
      ></path>
      <path fill="#FBBC05" d="M5.27 14.3a7.2 7.2 0 0 1 0-4.6V6.6H1.28a12 12 0 0 0 0 10.8z"></path>
      <path
        fill="#EA4335"
        d="M12 4.75c1.76 0 3.34.6 4.59 1.8l3.43-3.43A11.5 11.5 0 0 0 12 0 12 12 0 0 0 1.28 6.6l3.99 3.1C6.22 6.86 8.87 4.75 12 4.75z"
      ></path>
    </svg>
    使用 Google {verb}
  </button>
</div>
