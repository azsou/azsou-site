---
import { formatDate } from '@/lib/dates';
/**
 * 商店详情页主体（/apps/<slug>/ 自研应用与 /ai/<slug>/ 第三方 AI 工具共用；P10 PR G）。
 * 头部 DetailHero（图标 + 名称 + 开发者 + 类型徽标 → 指标条 → 主按钮含大小 + 官网 / GitHub / 分享）；
 * 正文：截图（灯箱）→ 简介（折叠）→ 特性要点 → AI 专属信息 → 新功能 → 信息表 → 版本历史 → 安全与来源 → 评价 → 隐私 → FAQ → 评论；
 * 导流区 DetailSide（≥ 1200 右侧栏）。只显示真实值：没有值的字段整项省略，不写「未提供」「—」。
 * 评分 / 下载数来自真实数据（app_review_stats / app_download_counts），只在评价区上方、有数据时显示，不进头部指标条。
 */
import Comments from '@/components/Comments.astro';
import AppIcon from '@/components/apps/AppIcon.astro';
import Screenshots from '@/components/apps/Screenshots.astro';
import Icon from '@/components/Icon.astro';
import Reviews from '@/components/apps/Reviews.astro';
import Status from '@/components/Status.astro';
import DetailHero from '@/components/detail/DetailHero.astro';
import DetailSide, { type SideGroup } from '@/components/detail/DetailSide.astro';
import { LINK_TYPE_LABEL, PLATFORM_LABEL, PRICE_LABEL, hostOf, type PlatformOs } from '@/lib/app-store';
import { url } from '@/lib/routes';
import { splitIntro, type StoreEntry } from '@/lib/store';
import type { App, Tool } from '@/lib/content';
import type { Hue } from '@/lib/hue';

interface Props {
  kind: 'app' | 'tool';
  slug: string;
  data: App['data'] | Tool['data'];
  /** 仓库里的可信 HTML 正文 */
  body: string;
  categoryLabel: string;
  categoryHref: string;
  /** 平台链接（应用 → /apps/platform/<os>/；工具没有平台页，传 null 只显示文字） */
  platformHref: ((os: PlatformOs) => string) | null;
  /** 色相（保留给图标垫板等；头部不再画横幅渐变） */
  hue: Hue;
  /** 统一条目模型（指标条 / 类型徽标） */
  entry: StoreEntry;
  /** 导流区（T10.13） */
  side: SideGroup[];
  articles?: { title: string; href: string; meta?: string }[];
}
const {
  kind,
  slug,
  data: d,
  body,
  categoryLabel,
  categoryHref,
  platformHref,
  entry,
  side,
  articles,
} = Astro.props;
const app = kind === 'app' ? (d as App['data']) : null;
const tool = kind === 'tool' ? (d as Tool['data']) : null;
const third = d.developer.type === 'third-party';
const latest = d.changelog[0];
const priceText = d.price.model === 'paid' && d.price.amount ? d.price.amount : PRICE_LABEL[d.price.model];
const usable = d.platforms.filter((p) => p.url);
const comingSoon = d.platforms.some((p) => !p.url && p.availability === 'coming-soon');
const devLink = d.developer.url;
const sizes = d.platforms.filter((p) => p.size);
const reqs = d.platforms.filter((p) => p.requirements);
const shotsIllustrative = d.screenshots.some((s) => s.illustrative);
const pageKey = `${kind === 'app' ? 'project' : 'tool'}:${slug}`;
const commentsId = `discussion-${pageKey.replace(/[^a-z0-9]+/gi, '-')}`;
const intro = splitIntro(body);
const repo = d.sourceRepo;
const site = d.website && !d.website.startsWith('/') ? d.website : undefined;
const sizeOf = (p: (typeof d.platforms)[number]) => p.size ?? (usable.length === 1 ? d.size : undefined);
const checksums = d.platforms.filter((p) => p.url && p.sha256);
const ai = tool?.ai;
const officialEntry = ai?.officialEntry;
const features = d.features ?? [];
const offline = d.platforms.filter((p) => !p.url);
const unavailable = (p: (typeof d.platforms)[number]) =>
  p.availability === 'coming-soon' ? '即将推出' : '暂未提供';
const hint = usable.length
  ? third
    ? '会先经过一个外链提示页，再前往官方渠道。本站不托管安装包。'
    : '会先经过一个外链提示页，显示来源与校验值。'
  : comingSoon
    ? '安装包即将推出。'
    : '开发者暂未提供下载地址。';
---

<article class="app-page detail" data-app-page data-app={slug} data-kind={kind}>
  <DetailHero
    entry={entry}
    title={d.title}
    subtitle={d.subtitle}
    developer={{ name: d.developer.name, url: devLink }}
  >
    <Fragment slot="icon">
      <AppIcon src={d.icon.src} variants={d.icon.variants} alt="" size="xl" eager />
      {d.icon.placeholder && <span class="app-hero__icon-note">临时图标</span>}
    </Fragment>
    <Fragment slot="badges">
      {third ? <span class="badge">第三方开发者</span> : <span class="badge">AZ Studio 出品</span>}
      {app && <Status cls={app.statusClass} text={app.status} />}
    </Fragment>
    <Fragment slot="actions">
      <div class="app-downloads detail-actions" data-downloads data-pagefind-ignore>
        {usable.map((p) => (
          <a
            class:list={['btn', 'dl-btn', { 'btn--primary': p.os === usable[0]?.os }]}
            href={url.go(slug, p.os)}
            rel="nofollow"
            data-os={p.os}
            data-has-url
          >
            <span>{p.linkType === 'web' ? '打开' : '获取'}</span>
            <span class="dl-btn__os">{PLATFORM_LABEL[p.os]}</span>
            {sizeOf(p) && <span class="dl-btn__size">· {sizeOf(p)}</span>}
          </a>
        ))}
        {/* 状态驱动主操作（T9.12）：没有可用安装包时主按钮是「上线时通知我」，不画禁用按钮 */}
        {!usable.length && (
          <a class="btn btn--primary dl-notify" href="/subscribe/" data-notify>
            <Icon name="bell" size={20} />
            上线时通知我
          </a>
        )}
      </div>
      {offline.length > 0 && (
        <p class="app-downloads__planned" data-planned data-pagefind-ignore>
          {usable.length ? '其他平台：' : '计划平台：'}
          {offline.map((p, i) => (
            <>
              {i > 0 && <span aria-hidden="true"> · </span>}
              <span
                class:list={['dl-off', { 'dl-off--soon': p.availability === 'coming-soon' }]}
                data-os={p.os}
              >
                {PLATFORM_LABEL[p.os]}（{unavailable(p)}）
              </span>
            </>
          ))}
        </p>
      )}
      <p class="app-downloads__hint muted" data-dl-hint data-pagefind-ignore>
        {hint}
        {comingSoon && !usable.length && (
          <>
            {' '}
            也可以 <a href={url.rss()}>订阅 RSS</a> 或 <a href={`#${commentsId}`}>在评论区留言</a>。
          </>
        )}
      </p>
    </Fragment>
    <Fragment slot="links">
      <p class="detail-links" data-detail-links data-pagefind-ignore>
        {site && (
          <a href={site} rel="noopener" data-link="site">
            <Icon name="globe" size={16} />
            官网
          </a>
        )}
        {officialEntry && (
          <a href={officialEntry} rel="noopener" data-link="entry">
            <Icon name="arrow-up-right" size={16} />
            国内入口
          </a>
        )}
        {repo && (
          <a href={repo} rel="noopener" data-link="github">
            <Icon name="github" size={16} />
            {hostOf(repo) === 'github.com' ? 'GitHub' : '源代码'}
          </a>
        )}
        <button type="button" data-share hidden>
          <Icon name="share" size={16} />
          分享
        </button>
        <span class="detail-share__status" data-share-status aria-live="polite"></span>
      </p>
    </Fragment>
  </DetailHero>

  <div class="detail-layout">
    <div class="detail-main">
      {app?.ownerReview && (
        <p class="notice mt-6" role="note">
          截图与下载地址公布后会在这里更新。
        </p>
      )}

      {d.screenshots.length > 0 && (
        <section class="section" aria-labelledby="h-shots">
          <div class="section__head">
            <h2 id="h-shots">{d.screenshots.every((x) => x.illustrative) ? '设计方向' : '截图'}</h2>
            {shotsIllustrative && <span class="badge badge--warn">概念图</span>}
          </div>
          <Screenshots title={d.title} shots={d.screenshots} />
          {shotsIllustrative && (
            <p class="muted mt-2 shots__caption">界面概念图，展示功能方向，最终界面以发布版为准。</p>
          )}
        </section>
      )}

      <section class="section" aria-labelledby="h-about">
        <h2 id="h-about">{third ? '介绍与点评' : '介绍'}</h2>
        <div class="prose mt-4" data-intro>
          <Fragment set:html={intro.lead} />
          {intro.rest && (
            <details class="intro-more" data-intro-more>
              <summary>展开全部介绍</summary>
              <Fragment set:html={intro.rest} />
            </details>
          )}
        </div>
      </section>

      {features.length > 0 && (
        <section class="section" aria-labelledby="h-features">
          <h2 id="h-features">特性要点</h2>
          <ul class="detail-features mt-4">
            {features.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
        </section>
      )}

      {tool && (
        <section class="section" aria-labelledby="h-ai" data-ai-facts>
          <h2 id="h-ai">定价与接入</h2>
          <dl class="info-table mt-4">
            {d.price.model !== 'tbd' && (
              <div data-ai="pricing">
                <dt>定价模式</dt>
                <dd>
                  {PRICE_LABEL[d.price.model]}
                  {d.price.note && <span class="muted">（{d.price.note}）</span>}
                </dd>
              </div>
            )}
            {ai?.freeTier && (
              <div data-ai="freeTier">
                <dt>免费额度</dt>
                <dd>{ai.freeTier}</dd>
              </div>
            )}
            <div data-ai="platforms">
              <dt>支持平台</dt>
              <dd>{d.platforms.map((p) => PLATFORM_LABEL[p.os]).join('、')}</dd>
            </div>
            {ai?.api && (
              <div data-ai="api">
                <dt>API</dt>
                <dd>{ai.api}</dd>
              </div>
            )}
            {ai?.mcp && (
              <div data-ai="mcp">
                <dt>MCP</dt>
                <dd>{ai.mcp}</dd>
              </div>
            )}
            {ai?.china && (
              <div data-ai="china">
                <dt>国内可用性</dt>
                <dd>{ai.china}</dd>
              </div>
            )}
            <div data-ai="entry">
              <dt>官方入口</dt>
              <dd>
                <a href={d.website} rel="noopener">
                  {hostOf(d.website!)}
                </a>
                {officialEntry && (
                  <>
                    {'；国内版 '}
                    <a href={officialEntry} rel="noopener">
                      {hostOf(officialEntry)}
                    </a>
                  </>
                )}
              </dd>
            </div>
          </dl>
        </section>
      )}

      {latest && (
        <section class="section" aria-labelledby="h-new">
          <div class="section__head">
            <h2 id="h-new">新功能</h2>
            {d.changelog.length > 1 && <a href="#h-history">版本历史</a>}
          </div>
          <div class="panel whats-new">
            <p class="whats-new__head">
              <b>{latest.version}</b> <time datetime={latest.date}>{formatDate(latest.date)}</time>
            </p>
            <ul>
              {latest.notes.map((n) => (
                <li>{n}</li>
              ))}
            </ul>
          </div>
        </section>
      )}

      <section class="section" aria-labelledby="h-info">
        <h2 id="h-info">信息</h2>
        <dl class="info-table mt-4">
          <div>
            <dt>开发者</dt>
            <dd>
              {devLink ? <a href={devLink}>{d.developer.name}</a> : d.developer.name}
              {third ? '（第三方）' : ''}
            </dd>
          </div>
          <div>
            <dt>分类</dt>
            <dd>
              <a href={categoryHref}>{categoryLabel}</a>
            </dd>
          </div>
          <div>
            <dt>平台</dt>
            <dd>
              {d.platforms.map((p, i) => (
                <>
                  {i > 0 && '、'}
                  {platformHref ? (
                    <a href={platformHref(p.os)}>{PLATFORM_LABEL[p.os]}</a>
                  ) : (
                    PLATFORM_LABEL[p.os]
                  )}
                  {p.version && p.version !== d.version && <span class="muted">（{p.version}）</span>}
                </>
              ))}
            </dd>
          </div>
          {entry.meta.version && (
            <div>
              <dt>版本</dt>
              <dd>{entry.meta.version}</dd>
            </div>
          )}
          {(sizes.length > 0 || d.size) && (
            <div>
              <dt>大小</dt>
              <dd>
                {sizes.length
                  ? sizes
                      .map((p) => `${PLATFORM_LABEL[p.os]} ${p.size}${p.arch ? `（${p.arch}）` : ''}`)
                      .join('；')
                  : d.size}
              </dd>
            </div>
          )}
          {reqs.length > 0 && (
            <div>
              <dt>兼容性</dt>
              <dd>{reqs.map((p) => `${PLATFORM_LABEL[p.os]}：${p.requirements}`).join('；')}</dd>
            </div>
          )}
          <div>
            <dt>获取方式</dt>
            <dd>
              {d.platforms
                .map(
                  (p) =>
                    `${PLATFORM_LABEL[p.os]}：${LINK_TYPE_LABEL[p.linkType]}${p.url ? `（${hostOf(p.url)}）` : `（${unavailable(p)}）`}`,
                )
                .join('；')}
            </dd>
          </div>
          {d.price.model !== 'tbd' && (
            <div>
              <dt>价格</dt>
              <dd>
                {priceText}
                {d.price.note && <span class="muted">（{d.price.note}）</span>}
              </dd>
            </div>
          )}
          <div>
            <dt>许可</dt>
            <dd>
              {d.license}
              {d.openSource && '（开源）'}
            </dd>
          </div>
          {d.sourceRepo && (
            <div>
              <dt>源代码</dt>
              <dd>
                <a href={d.sourceRepo} rel="noopener">
                  {hostOf(d.sourceRepo)}
                </a>
              </dd>
            </div>
          )}
          {d.website && (
            <div>
              <dt>官网</dt>
              <dd>
                <a href={d.website} rel={d.website.startsWith('/') ? undefined : 'noopener'}>
                  {d.website.startsWith('/') ? '本站介绍页' : hostOf(d.website)}
                </a>
              </dd>
            </div>
          )}
          {app?.releaseDate && (
            <div>
              <dt>首次发布</dt>
              <dd>
                <time datetime={app.releaseDate}>{formatDate(app.releaseDate)}</time>
              </dd>
            </div>
          )}
          {d.updated && (
            <div>
              <dt>最近更新</dt>
              <dd>
                <time datetime={d.updated}>{formatDate(d.updated)}</time>
              </dd>
            </div>
          )}
          {d.lastChecked && (
            <div>
              <dt>最后核对</dt>
              <dd>
                <time datetime={d.lastChecked}>{formatDate(d.lastChecked)}</time>
              </dd>
            </div>
          )}
          {third && (
            <div>
              <dt>图标</dt>
              <dd>图标版权归各自所有者，取自官方网站或官方 GitHub 账号，仅用于识别。</dd>
            </div>
          )}
          {/* 真实计数由 island 填入；0 次或数据库不可达时整行保持隐藏（不显示占位） */}
          <div data-downloads-row hidden>
            <dt>{third ? '跳转次数' : '下载次数'}</dt>
            <dd data-downloads-detail></dd>
          </div>
        </dl>
      </section>

      {d.changelog.length > 0 && (
        <section class="section" aria-labelledby="h-history">
          <h2 id="h-history">版本历史</h2>
          <ol class="timeline mt-4">
            {d.changelog.map((c) => (
              <li>
                <time datetime={c.date}>{formatDate(c.date)}</time> <b>{c.version}</b>
                {c.notes.map((n) => (
                  <p>{n}</p>
                ))}
              </li>
            ))}
          </ol>
        </section>
      )}

      <section class="section" aria-labelledby="h-source" data-source-note>
        <h2 id="h-source">安全与来源</h2>
        <div class="panel mt-4 detail-source">
          <p>
            链接指向官方渠道，本站不托管安装包。
            {usable.length > 0 && '点击获取会先经过外链提示页，显示目标地址。'}
          </p>
          {checksums.length > 0 && (
            <ul class="mt-2" data-checksums>
              {checksums.map((p) => (
                <li>
                  {PLATFORM_LABEL[p.os]} SHA-256：<code>{p.sha256}</code>
                </li>
              ))}
            </ul>
          )}
          {d.lastChecked && (
            <p class="muted mt-2">
              信息最后核对于 <time datetime={d.lastChecked}>{formatDate(d.lastChecked)}</time>
              ，以官方页面为准。
            </p>
          )}
        </div>
      </section>

      <dl class="app-stats app-stats--below" data-app-stats data-pagefind-ignore>
        <div class="app-stat" data-stat-rating hidden>
          <dt>评分</dt>
          <dd>
            <span class="app-stat__value" data-rating-value>
              —
            </span>
            <span class="app-stat__sub" data-rating-sub>
              暂无评分
            </span>
          </dd>
        </div>
        <div class="app-stat" data-stat-downloads hidden>
          <dt>{third ? '跳转' : '下载'}</dt>
          <dd>
            <span class="app-stat__value" data-downloads-total>
              —
            </span>
            <span class="app-stat__sub">累计</span>
          </dd>
        </div>
      </dl>

      <Reviews app={slug} title={d.title} version={d.version ?? ''} />

      <section class="section" aria-labelledby="h-privacy">
        <h2 id="h-privacy">隐私</h2>
        <div class="panel mt-4">
          {d.privacy ? (
            <>
              <p>
                {d.privacy.collects.length
                  ? `开发者说明会收集：${d.privacy.collects.join('、')}。`
                  : '开发者说明：不收集任何数据。'}
              </p>
              {d.privacy.note && <p class="muted mt-2">{d.privacy.note}</p>}
              {d.privacy.policyUrl && (
                <p class="mt-2">
                  <a href={d.privacy.policyUrl}>查看隐私政策</a>
                </p>
              )}
            </>
          ) : third ? (
            <p class="muted">
              这是第三方服务，数据如何收集与使用请以 <a href={d.website}>{d.developer.name} 官方隐私政策</a>{' '}
              为准。
            </p>
          ) : (
            <p class="muted">开发者尚未提供隐私说明。</p>
          )}
          <p class="muted mt-2">
            本站{third ? '跳转' : '下载'}中转只记录「某个{third ? '工具' : '应用'}的某个平台被
            {third ? '打开' : '下载'}了一次」，不保存访客 IP（只存每日轮换的加盐哈希用于去重，2 天后删除）。
          </p>
        </div>
      </section>

      {d.faq.length > 0 && (
        <section class="section" aria-labelledby="h-faq">
          <h2 id="h-faq">常见问题</h2>
          <div class="faq mt-4">
            {d.faq.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      {app && (app.verification.length > 0 || app.issues) && (
        <section class="section" aria-labelledby="h-verify">
          <h2 id="h-verify">验证与已知问题</h2>
          {app.verification.length > 0 && (
            <ul class="list-group mt-4" role="list">
              {app.verification.map((v) => (
                <li class="list-row">
                  <span class="list-row__main">
                    <span class="list-row__title">{v.label}</span>
                    <br />
                    <span class="list-row__sub">{v.note}</span>
                  </span>
                  <span class="list-row__aside">{v.value}</span>
                </li>
              ))}
            </ul>
          )}
          {app.issues && <p class="mt-4">{app.issues}</p>}
        </section>
      )}

      <Comments pageKey={pageKey} />
    </div>
    <DetailSide label={`与 ${d.title} 相关`} groups={side} articles={articles} />
  </div>
</article>
