---
import type { App } from '@/lib/content';
import { url } from '@/lib/routes';
import Status from './Status.astro';
interface Props {
  app: App;
  headingLevel?: 'h2' | 'h3';
}
const { app, headingLevel = 'h2' } = Astro.props;
const H = headingLevel;
const d = app.data;
---

<article class="card card--row">
  <span class="app-icon" data-hue={d.hue} aria-hidden="true">
    {d.icon}
  </span>
  <div class="card__body">
    <H class="card__title">
      <a class="card__link" href={url.app(app.id)}>
        {d.title}
      </a>
    </H>
    <p class="card__text">{d.summary}</p>
    <div class="card__meta">
      <span>{d.kind}</span>
      <span aria-hidden="true">·</span>
      <span>{d.version}</span>
      <Status cls={d.statusClass} text={d.status} />
    </div>
  </div>
</article>
