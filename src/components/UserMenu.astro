---
import Icon from './Icon.astro';
---

<div class="user-menu" data-user-menu>
  <a class="icon-btn" href="/login/" data-signed-out aria-label="登录 / 注册">
    <Icon name="user" />
  </a>
  <button
    class="avatar-btn"
    type="button"
    data-signed-in
    hidden
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="user-menu-pop"
  >
    <span class="avatar avatar--sm" data-initials aria-hidden="true"></span>
    <span class="visually-hidden" data-btn-label>
      账户菜单
    </span>
    <span class="nav-badge" data-unread-badge aria-hidden="true" hidden></span>
  </button>
  <div class="menu glass" id="user-menu-pop" data-menu hidden>
    <p class="menu__head">
      <strong data-name></strong>
      <span data-email></span>
    </p>
    <div role="menu" aria-label="账户">
      <a role="menuitem" href="/u/" data-profile-link>
        我的主页
      </a>
      <a role="menuitem" href="/notifications/">
        通知<span class="menu__count" data-unread-count hidden></span>
      </a>
      <a role="menuitem" href="/bookmarks/">
        我的收藏
      </a>
      <a role="menuitem" href="/settings/">
        账户设置
      </a>
      <a role="menuitem" href="/admin/" data-admin-link hidden>
        管理后台
      </a>
      <button role="menuitem" type="button" data-signout>
        退出登录
      </button>
    </div>
  </div>
</div>

<script>
  import { whenIdle } from '@/scripts/idle';
  whenIdle(() => import('@/scripts/user-menu').then((m) => m.initUserMenu()), 500);
</script>
