---
/** 站长账号图标（T7.4）：只渲染 src/data/social.json 里有 url 的账号 */
import { SOCIAL, type SocialId } from '@/lib/social';
interface Props {
  variant?: 'icons' | 'list';
  lang?: 'zh' | 'en';
}
const { variant = 'icons', lang = 'zh' } = Astro.props;
const P: Record<SocialId, string> = {
  github:
    'M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.56 9.56 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2z',
  rss: 'M5 3a16 16 0 0 1 16 16h-3A13 13 0 0 0 5 6zm0 6a10 10 0 0 1 10 10h-3a7 7 0 0 0-7-7zm1.5 7a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5z',
  bilibili:
    'M7.2 3.4 9.6 6h4.8l2.4-2.6 1.4 1.3L16.8 6H19a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3V9a3 3 0 0 1 3-3h2.2L5.8 4.7zM5 8a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V9a1 1 0 0 0-1-1zm3 3.5h2v2H8zm6 0h2v2h-2z',
  youtube:
    'M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4a2.5 2.5 0 0 0-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8zM10 15V9l5.2 3z',
  email: 'M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm1 2.4V17h16V7.4l-8 5.3z',
};
const ext = (u: string) => /^https?:\/\//.test(u);
---

{SOCIAL.length > 0 &&
  (variant === 'icons' ? (
    <ul class="social" role="list" aria-label={lang === 'en' ? "Author's accounts" : '作者的账号'}>
      {SOCIAL.map((a) => (
        <li>
          <a
            class="icon-btn social__link"
            href={a.url}
            rel={ext(a.url) ? 'me noopener' : undefined}
            aria-label={lang === 'en' && a.id === 'rss' ? 'RSS feed' : a.name}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path fill="currentColor" d={P[a.id]} />
            </svg>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <ul class="list-group" role="list" aria-label={lang === 'en' ? "Author's accounts" : '作者的账号'}>
      {SOCIAL.map((a) => (
        <li>
          <a class="list-row" href={a.url} rel={ext(a.url) ? 'me noopener' : undefined}>
            <span class="social__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path fill="currentColor" d={P[a.id]} />
              </svg>
            </span>
            <span class="list-row__main">
              <span class="list-row__title">{a.name}</span>
              <br />
              <span class="list-row__sub">{a.handle}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  ))}
