---
import AdminLayout from '@/layouts/AdminLayout.astro';
---

<AdminLayout
  section="users"
  title="用户"
  lede="搜索用户、查看资料与发布的内容；版主可以封禁 / 解封普通用户，管理员可以修改角色。"
>
  <form class="toolbar" role="search" data-filters>
    <div class="field field--grow">
      <label for="us-q">搜索</label>
      <input
        id="us-q"
        name="q"
        type="search"
        placeholder="昵称或用户 ID（管理员还可搜邮箱）"
        autocomplete="off"
      />
    </div>
    <div class="field">
      <label for="us-role">角色</label>
      <select id="us-role" name="role">
        <option value="">全部</option>
        <option value="user">用户</option>
        <option value="moderator">版主</option>
        <option value="admin">管理员</option>
      </select>
    </div>
    <div class="field">
      <label for="us-banned">状态</label>
      <select id="us-banned" name="banned">
        <option value="">全部</option>
        <option value="0">正常</option>
        <option value="1">封禁中</option>
      </select>
    </div>
    <button class="btn" type="submit">
      筛选
    </button>
  </form>
  <div class="table-wrap">
    <table class="data-table">
      <caption class="visually-hidden">用户列表</caption>
      <thead>
        <tr>
          <th scope="col">用户</th>
          <th scope="col">角色</th>
          <th scope="col">状态</th>
          <th scope="col" class="num">
            主题
          </th>
          <th scope="col" class="num">
            回复
          </th>
          <th scope="col" class="num">
            评论
          </th>
          <th scope="col" class="num">
            被举报
          </th>
          <th scope="col">注册时间</th>
        </tr>
      </thead>
      <tbody data-rows aria-busy="true"></tbody>
    </table>
  </div>
  <nav class="pagination" aria-label="分页" data-pager></nav>
  <p class="data-status" role="status" data-status></p>
</AdminLayout>

<script>
  import '@/scripts/admin/users';
</script>
