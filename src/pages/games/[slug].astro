---
import Base from '@/layouts/Base.astro';
import Art from '@/components/Art.astro';
import Comments from '@/components/Comments.astro';
import { getGames, type Game } from '@/lib/content';
import { url, ogArt } from '@/lib/routes';
import { videoGame } from '@/lib/seo';
import { excerpt } from '@/lib/escape';

export async function getStaticPaths() {
  const games = await getGames();
  return games.map((game, i) => ({
    params: { slug: game.id },
    props: { game, prev: games[i - 1] ?? null, next: games[i + 1] ?? null },
  }));
}
const { game, prev, next } = Astro.props as { game: Game; prev: Game | null; next: Game | null };
const d = game.data;
// 正文是迁移来的可信 HTML（仓库内容），原样输出
const bodyHtml = game.body ?? '';
const path = url.game(game.id);
const description = excerpt(bodyHtml, 110);
---

<Base
  title={`${d.title} · ${d.genre}`}
  description={description}
  image={ogArt(d.art)}
  imageAlt={d.title}
  crumbs={[
    { name: '首页', path: '/' },
    { name: '游戏', path: '/games/' },
    { name: d.title, path },
  ]}
  schema={[
    videoGame({
      name: d.title,
      description,
      path,
      genre: d.genre,
      version: d.version,
      image: ogArt(d.art),
      date: d.date,
    }),
  ]}
>
  <header class="page-head">
    <p class="eyebrow">
      {d.kind} · {d.genre}
    </p>
    <h1>{d.title}</h1>
    <div class="article-meta">
      <span>版本 {d.version}</span>
      <span>{d.status}</span>
      <span>
        最后核对 <time datetime={d.date}>{d.date}</time>
      </span>
    </div>
  </header>
  <div class="split">
    <div>
      <div class="hero-media">
        <Art slot={d.art} eager />
      </div>
      <section class="prose" aria-label="简介">
        <Fragment set:html={bodyHtml} />
      </section>
      <section class="section" aria-labelledby="h-log">
        <h2 id="h-log">开发日志</h2>
        <ol class="timeline mt-4">
          {d.log.map((l) => (
            <li>
              <time datetime={l.date}>{l.date}</time> <b>{l.version}</b>
              <p>{l.note}</p>
            </li>
          ))}
        </ol>
      </section>
      <section class="section" aria-labelledby="h-issues">
        <h2 id="h-issues">已知问题</h2>
        <p class="mt-4">{d.issues}</p>
      </section>
      <nav class="pager" aria-label="上下一个游戏">
        {prev && (
          <a href={url.game(prev.id)}>
            <small>上一个</small>
            {prev.data.title}
          </a>
        )}
        {next && (
          <a href={url.game(next.id)}>
            <small>下一个</small>
            {next.data.title}
          </a>
        )}
      </nav>
      <Comments pageKey={`game:${game.id}`} />
    </div>
    <aside aria-label="游戏信息">
      <section class="panel">
        <h2>游戏事实</h2>
        <dl class="facts">
          {d.facts.map((f) => (
            <>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </>
          ))}
        </dl>
      </section>
      <section class="panel">
        <h2>试玩</h2>
        <p class="muted">v2 迁移中：可玩构建的入口链接待作者补充。</p>
      </section>
    </aside>
  </div>
</Base>
