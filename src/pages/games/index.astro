---
import Base from '@/layouts/Base.astro';
import { itemList } from '@/lib/seo';
import { url } from '@/lib/routes';
import PageHead from '@/components/PageHead.astro';
import AppTile from '@/components/store/AppTile.astro';
import ListShell from '@/components/store/ListShell.astro';
import { getGames } from '@/lib/content';
import { fromGame, sortEntries } from '@/lib/store';
const games = await getGames();
/** T10.8：统一列表外壳；分类栏 = 按形态（开发中 / Web 3D）单套筛选（list-filter.ts） */
const kinds = [...new Set(games.map((g) => g.data.kind))];
const entries = sortEntries(games.map(fromGame), 'new');
---

<Base
  title="游戏与原型"
  description="EMBERDEEP、Three.js 魔方、声波塔防等浏览器游戏与原型：版本号如实反映完成度，附开发日志与已知问题。"
  schema={[
    itemList(
      '游戏与原型',
      '/games/',
      games.map((g) => ({ name: g.data.title, path: url.game(g.id) })),
    ),
  ]}
  crumbs={[
    { name: '首页', path: '/' },
    { name: '游戏', path: '/games/' },
  ]}
>
  <PageHead
    eyebrow="游戏"
    title="游戏与原型"
    lede="浏览器里的 Roguelike、Web 3D 与物理小品。不包装成商业发行，版本号如实反映完成度。"
  />
  <ListShell
    railLabel="形态"
    railName="按形态筛选"
    filterParam="kind"
    rail={[
      { label: '全部', value: '', count: games.length, current: true },
      ...kinds.map((k) => ({ label: k, value: k, count: games.filter((g) => g.data.kind === k).length })),
    ]}
    status={`共 ${games.length} 个游戏`}
    statusAttrs={{ 'data-list-status': '', 'data-noun': '个游戏' }}
  >
    <ul class="list-items" data-grid="tile" role="list" data-list-items data-view="grid">
      {entries.map((e, i) => (
        <li data-filter-item data-filter-value={e.category.id}>
          <AppTile entry={e} headingLevel="h2" eager={i < 10} fields={['category', 'version', 'updatedAt']} />
        </li>
      ))}
    </ul>
  </ListShell>
</Base>

<script>
  import { whenIdle } from '@/scripts/idle';
  whenIdle(() => import('@/scripts/list-filter'));
</script>
