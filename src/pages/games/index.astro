---
import Base from '@/layouts/Base.astro';
import { itemList } from '@/lib/seo';
import { url } from '@/lib/routes';
import PageHead from '@/components/PageHead.astro';
import GameCard from '@/components/GameCard.astro';
import { getGames } from '@/lib/content';
const games = await getGames();
/** T9.12 单套筛选：按形态（可玩 Demo / 开发中 / Web 3D）分段筛选，条目少于两种形态时不显示 */
const kinds = [...new Set(games.map((g) => g.data.kind))];
---

<Base
  title="游戏与可玩 Demo"
  description="EMBERDEEP、Three.js 魔方、声波塔防等浏览器游戏与原型：版本号如实反映完成度，附开发日志与已知问题。"
  schema={[
    itemList(
      '游戏与可玩 Demo',
      '/games/',
      games.map((g) => ({ name: g.data.title, path: url.game(g.id) })),
    ),
  ]}
  crumbs={[
    { name: '首页', path: '/' },
    { name: '游戏', path: '/games/' },
  ]}
>
  <PageHead
    eyebrow="游戏"
    title="游戏与可玩 Demo"
    lede="浏览器里的 Roguelike、Web 3D 与物理小品。不包装成商业发行，版本号如实反映完成度。"
  />
  {kinds.length > 1 && (
    <div class="filter-bar">
      <div class="segmented" role="group" aria-label="按形态筛选" data-list-filter data-param="kind">
        <button type="button" data-value="" aria-pressed="true" disabled>
          全部
        </button>
        {kinds.map((k) => (
          <button type="button" data-value={k} aria-pressed="false" disabled>
            {k}
          </button>
        ))}
      </div>
      <p class="filter-bar__status muted" data-list-status data-noun="个游戏" role="status">
        共 {games.length} 个游戏
      </p>
    </div>
  )}
  <div class="grid" data-grid="media">
    {games.map((g, i) => (
      <GameCard game={g} eager={i < 2} filterValue={g.data.kind} />
    ))}
  </div>
</Base>

<script>
  import { whenIdle } from '@/scripts/idle';
  whenIdle(() => import('@/scripts/list-filter'));
</script>
