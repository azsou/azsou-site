---
import Base from '@/layouts/Base.astro';
import { itemList } from '@/lib/seo';
import { url } from '@/lib/routes';
import PageHead from '@/components/PageHead.astro';
import WorkCard from '@/components/WorkCard.astro';
import ListShell from '@/components/store/ListShell.astro';
import { getWorks } from '@/lib/content';
const works = await getWorks();
const kinds = [...new Set(works.map((w) => w.data.kind))];
const inKind = (k: string) => works.filter((w) => w.data.kind === k);
// T10.8 统一列表外壳：默认按日期新的在前；排序键与商店条目同名（data-sort-*）
const sorted = [...works].sort(
  (a, b) => b.data.date.localeCompare(a.data.date) || a.data.order - b.data.order,
);
---

<Base
  title="作品与视频"
  description="动画、游戏画面与 AI 图像实验：每件作品附工具、参数与验证记录。视觉素材由站内确定性生成器绘制。"
  schema={[
    itemList(
      '作品与视频',
      '/works/',
      works.map((g) => ({ name: g.data.title, path: url.work(g.id) })),
    ),
  ]}
  crumbs={[
    { name: '首页', path: '/' },
    { name: '作品', path: '/works/' },
  ]}
>
  <PageHead
    eyebrow="作品"
    title="作品与视频"
    lede="动画、游戏画面与 AI 图像实验。当前配图由站内生成式 SVG 系统绘制，未来逐项替换为实机截图。"
  />
  <ListShell
    railLabel="类别"
    railName="按类别筛选"
    filterParam="kind"
    rail={[
      { label: '全部', value: '', count: works.length, current: true },
      ...kinds.map((k) => ({ label: k, value: k, count: inKind(k).length })),
    ]}
    status={`共 ${works.length} 件作品`}
    statusAttrs={{ 'data-list-status': '', 'data-noun': '件作品' }}
  >
    <ul class="list-items list-items--media" role="list" data-list-items data-view="grid">
      {sorted.map((w) => (
        <li
          data-filter-item
          data-filter-value={w.data.kind}
          data-sort-new={w.data.date}
          data-sort-name={(w.data.pinyin || w.data.title).toLowerCase()}
          data-sort-editor={String(w.data.order)}
        >
          <WorkCard work={w} headingLevel="h2" />
        </li>
      ))}
    </ul>
  </ListShell>
</Base>

<script>
  import { whenIdle } from '@/scripts/idle';
  whenIdle(() => import('@/scripts/list-filter'));
</script>
