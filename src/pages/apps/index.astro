---
import AppCatalog from '@/components/apps/AppCatalog.astro';
import { getCatalog } from '@/lib/content';
const all = await getCatalog();
---

<AppCatalog
  title="应用"
  description="AZ Studio 出品与精选的应用：创作工具、浏览器工具、效率工具、AI 工具与开发工具，可按平台、分类、价格筛选，查看版本与评价。"
  lede="AZ Studio 出品与精选的应用，可按平台、分类与价格筛选。"
  all={all}
  items={all}
  page={1}
  base="/apps/"
  crumbs={[
    { name: '首页', path: '/' },
    { name: '应用', path: '/apps/' },
  ]}
/>
