---
import AppCatalog from '@/components/apps/AppCatalog.astro';
import { getCatalog } from '@/lib/content';
const all = await getCatalog();
---

<AppCatalog
  title="应用商店"
  description="AZ Studio 的应用目录：创作工具、浏览器工具、效率工具、AI 工具与开发工具。按平台、分类、价格筛选，评分与下载数全部来自真实用户。"
  lede="按平台、分类与价格筛选。评分来自真实用户评价，下载数是真实计数——没有就显示「暂无」。"
  all={all}
  items={all}
  page={1}
  base="/apps/"
  crumbs={[
    { name: '首页', path: '/' },
    { name: '应用', path: '/apps/' },
  ]}
/>
