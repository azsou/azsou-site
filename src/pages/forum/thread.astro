---
import Base from '@/layouts/Base.astro';
---

<Base
  title="论坛主题"
  description="AZ Studio 论坛用户主题（只读预览）。"
  noindex
  crumbs={[
    { name: '首页', path: '/' },
    { name: '论坛', path: '/forum/' },
    { name: '主题', path: '/forum/thread/' },
  ]}
>
  <article data-forum-dynamic>
    <header class="page-head">
      <p class="eyebrow">论坛 · 用户主题</p>
      <h1 data-title>正在加载主题…</h1>
      <div class="article-meta" data-meta></div>
    </header>
    <div class="panel prose" data-body>
      <p class="muted">内容加载中。</p>
    </div>
    <section class="discussion panel" aria-labelledby="h-replies">
      <div class="section__head">
        <h2 id="h-replies">回复</h2>
        <span class="muted" data-count></span>
      </div>
      <ul class="list-reset" role="list" data-list></ul>
    </section>
    <p class="data-status" data-status role="status"></p>
  </article>
</Base>

<script>
  import '@/scripts/forum';
</script>
