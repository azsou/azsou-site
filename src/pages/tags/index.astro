---
import Base from '@/layouts/Base.astro';
import PageHead from '@/components/PageHead.astro';
import { getArticles } from '@/lib/content';
import { TAGS } from '@/lib/tags';
import { url } from '@/lib/routes';
const articles = await getArticles();
const counts = Object.keys(TAGS)
  .map((t) => ({ t, n: articles.filter((a) => a.data.tags.includes(t)).length }))
  .filter((x) => x.n > 0);
---

<Base
  title="标签"
  description="按主题浏览 AZ Studio 的原创文章：开发实践、FableMotion、浏览器扩展、AI 游戏、实测与复盘。"
  crumbs={[
    { name: '首页', path: '/' },
    { name: '标签', path: '/tags/' },
  ]}
>
  <PageHead eyebrow="标签" title="按主题浏览" />
  <ul class="list-group" role="list">
    {counts.map(({ t, n }) => (
      <li>
        <a class="list-row" href={url.tag(t)}>
          <span class="list-row__main">
            <span class="list-row__title">{TAGS[t].name}</span>
            <br />
            <span class="list-row__sub">{TAGS[t].description}</span>
          </span>
          <span class="list-row__aside">{n} 篇</span>
        </a>
      </li>
    ))}
  </ul>
</Base>
