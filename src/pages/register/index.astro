---
import Base from '@/layouts/Base.astro';
import OAuthButtons from '@/components/OAuthButtons.astro';
import TurnstileField from '@/components/TurnstileField.astro';
---

<Base
  title="注册"
  description="注册 AZ Studio 账户，参与论坛讨论与评论。支持邮箱注册，或直接使用 GitHub / Google 账户。"
  noindex
  crumbs={[
    { name: '首页', path: '/' },
    { name: '注册', path: '/register/' },
  ]}
>
  <div class="auth-wrap">
    <section class="auth-card" aria-labelledby="register-title" data-register-panel>
      <h1 id="register-title">注册</h1>
      <p class="auth-card__lede">注册后即可在论坛发帖、回复和评论。</p>
      <form class="form" data-auth-form="register" novalidate>
        <div class="field">
          <label for="reg-name">昵称</label>
          <input
            id="reg-name"
            name="displayName"
            type="text"
            autocomplete="nickname"
            maxlength="40"
            required
          />
          <p class="field__hint">1–40 个字符，公开显示，之后可以在设置里修改。</p>
          <p class="field__error" data-error-for="displayName"></p>
        </div>
        <div class="field">
          <label for="reg-email">邮箱</label>
          <input id="reg-email" name="email" type="email" autocomplete="email" inputmode="email" required />
          <p class="field__error" data-error-for="email"></p>
        </div>
        <div class="field">
          <label for="reg-password">密码</label>
          <input
            id="reg-password"
            name="password"
            type="password"
            autocomplete="new-password"
            minlength="8"
            maxlength="72"
            required
          />
          <p class="field__hint">至少 8 位，同时包含字母和数字。</p>
          <p class="field__error" data-error-for="password"></p>
        </div>
        <div class="field">
          <label for="reg-password2">确认密码</label>
          <input id="reg-password2" name="password2" type="password" autocomplete="new-password" required />
          <p class="field__error" data-error-for="password2"></p>
        </div>
        <TurnstileField action="signup" />
        <label class="check">
          <input type="checkbox" name="agree" required />
          <span>
            我已阅读并同意<a href="/terms/">使用条款</a>与<a href="/privacy/">隐私说明</a>。
          </span>
        </label>
        <p class="field__error" data-error-for="agree"></p>
        <p class="notice notice--error form-status" role="alert" data-form-status></p>
        <button class="btn btn--primary btn--block" type="submit">
          注册
        </button>
      </form>
      <div class="divider">或</div>
      <OAuthButtons verb="注册" />
      <p class="auth-foot">
        已经有账户？<a href="/login/">登录</a>
      </p>
    </section>

    <section class="auth-card" aria-labelledby="register-done-title" data-register-done hidden>
      <h2 id="register-done-title">请查收确认邮件</h2>
      <p class="auth-card__lede">
        我们已向 <strong data-done-email></strong> 发送了一封确认邮件。点击邮件里的链接完成验证后即可登录。
      </p>
      <p class="field__hint">
        没收到？检查垃圾邮件文件夹，或几分钟后
        <a href="/register/?mode=resend" data-done-resend>
          重新发送
        </a>
        。
      </p>
      <div class="btn-row mt-4">
        <a class="btn btn--primary" href="/login/">
          去登录
        </a>
      </div>
    </section>

    <section class="auth-card" aria-labelledby="resend-title" data-resend-panel hidden>
      <h2 id="resend-title">重新发送确认邮件</h2>
      <p class="auth-card__lede">输入注册时使用的邮箱，我们会重新发送确认链接。</p>
      <form class="form" data-auth-form="resend" novalidate>
        <div class="field">
          <label for="resend-email">邮箱</label>
          <input
            id="resend-email"
            name="email"
            type="email"
            autocomplete="email"
            inputmode="email"
            required
          />
          <p class="field__error" data-error-for="email"></p>
        </div>
        <TurnstileField action="resend" />
        <p class="notice notice--error form-status" role="alert" data-form-status></p>
        <button class="btn btn--primary btn--block" type="submit">
          重新发送
        </button>
      </form>
      <p class="auth-foot">
        <a href="/login/">返回登录</a>
      </p>
    </section>
  </div>
  <script>
    import '@/scripts/auth-pages';
  </script>
</Base>
