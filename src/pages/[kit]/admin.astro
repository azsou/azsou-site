---
/**
 * /_kit/admin/ 后台组件样张（T9.16，DESIGN-SYSTEM §14）：数据表（有数据 / 加载骨架 / 空 / 筛选后空 / 错误）、
 * 窄屏卡片、行操作「⋯」菜单（展开态）、批量工具栏、状态徽标、统计卡、权限状态卡、提示条、危险确认对话框。
 * 纯静态标记（与 src/scripts/admin/table.ts 渲染的结构一致），不需要数据库；视觉回归基线用它。
 * 只在非生产构建输出；noindex。
 */
import '@/styles/community.css';
import '@/styles/admin.css';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';

export function getStaticPaths() {
  return process.env.VERCEL_ENV === 'production' ? [] : [{ params: { kit: '_kit' } }];
}

const rows = [
  {
    title: 'Godot 4.5 的 TileMapLayer 迁移踩坑记录：旧场景批量转换脚本分享',
    sub: '背景 升级到 4.5 之后，TileMap 被拆成多个 TileMapLayer，旧场景需要……',
    author: '像素旅人',
    badges: [
      ['ok', '已发布'],
      ['info', '置顶'],
      ['accent', '精华'],
    ],
    cat: '技术交流',
    reports: 0,
    time: '2026-10-24 17:12',
    quick: '隐藏',
    selected: false,
  },
  {
    title: '求推荐：独立开发者用的轻量崩溃上报方案',
    sub: '目前用的是自建 Sentry，内存占用有点大。大家都用什么？',
    author: 'Mika',
    badges: [['ok', '已发布']],
    cat: '产品讨论',
    reports: 2,
    time: '2026-10-23 22:30',
    quick: '隐藏',
    selected: true,
  },
  {
    title: '广告：低价出售游戏账号',
    sub: '加 V 私聊……',
    author: 'Mika',
    badges: [
      ['danger', '已隐藏'],
      ['muted', '已锁定'],
    ],
    cat: '站务反馈',
    reports: 5,
    time: '2026-10-22 11:05',
    quick: '恢复',
    selected: false,
  },
];
const TH = ['作者', '分类', '状态', '举报', '时间'];
const PRI = ['2', '3', '2', '3', '3'];
---

<Base
  title="后台组件目录"
  description="AZ Studio 后台组件样张（开发用）"
  noindex
  crumbs={[
    { name: '首页', path: '/' },
    { name: '组件目录', path: '/_kit/' },
    { name: '后台', path: '/_kit/admin/' },
  ]}
>
  <div class="kit-admin">
    <h1>后台组件</h1>
    <p class="muted">
      DESIGN-SYSTEM §14：行高 52、吸顶表头、复选框命中区 32、主列一行标题 + 一行纯文本摘要、次列 ≤ 4（&lt;
      1200 隐藏优先级 3）、操作 = 1 个快捷按钮 +「⋯」；&lt; 900 为卡片（主列 + 2 个 meta + 操作）。
    </p>

    <h2>统计卡（等宽 4 / 2 / 1 列）</h2>
    <ul class="stat-grid" role="list">
      <li>
        <a class="stat" href="#t">
          <span class="stat__label">用户</span>
          <span class="stat__value">128</span>
          <span class="stat__sub">版主 3 · 管理员 1</span>
        </a>
      </li>
      <li>
        <a class="stat" href="#t">
          <span class="stat__label">主题</span>
          <span class="stat__value">342</span>
          <span class="stat__sub">6 条已隐藏</span>
        </a>
      </li>
      <li>
        <a class="stat stat--alert" href="#t">
          <span class="stat__label">待处理举报</span>
          <span class="stat__value">3</span>
          <span class="stat__sub">点击处理</span>
        </a>
      </li>
      <li>
        <span class="stat">
          <span class="stat__label">近 7 天注册</span>
          <span class="stat__value">14</span>
          <span class="stat__sub">近 30 天 52</span>
        </span>
      </li>
    </ul>

    <h2 id="t">数据表 · 有数据（第 2 行已选，批量工具栏出现）</h2>
    <div class="bulkbar glass">
      <span class="bulkbar__count">已选 1 项</span>
      <button class="btn btn--sm" type="button">
        隐藏
      </button>
      <button class="btn btn--sm" type="button">
        恢复
      </button>
      <button class="btn btn--sm btn--danger" type="button">
        删除
      </button>
      <button class="btn btn--sm btn--text" type="button">
        取消选择
      </button>
    </div>
    <div class="table-wrap">
      <table class="data-table" data-cards data-truncate-ok>
        <caption class="visually-hidden">主题列表（样张）</caption>
        <thead>
          <tr>
            <th scope="col" class="col-check">
              <span class="visually-hidden">选择</span>
            </th>
            <th scope="col">内容</th>
            {TH.map((t, i) => (
              <th scope="col" data-priority={PRI[i]} class={t === '举报' ? 'num' : undefined}>
                {t}
              </th>
            ))}
            <th scope="col" class="col-actions">
              <span class="visually-hidden">操作</span>
            </th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r, i) => (
            <tr data-row data-selected={String(r.selected)}>
              <td class="col-check">
                <label class="check-hit">
                  <input type="checkbox" checked={r.selected} aria-label={`选择：${r.title}`} />
                </label>
              </td>
              <td class="cell-main">
                <a class="cell-title" href="#t">
                  {r.title}
                </a>
                <span class="cell-sub">{r.sub}</span>
              </td>
              <td data-priority="2">
                <a href="#t">{r.author}</a>
              </td>
              <td data-priority="3">{r.cat}</td>
              <td data-priority="2">
                <span class="badges">
                  {r.badges.map(([k, t]) => (
                    <span class={`badge badge--${k}`}>{t}</span>
                  ))}
                </span>
              </td>
              <td class="num" data-priority="3">
                {r.reports ? <span class="badge badge--danger">{r.reports}</span> : '0'}
              </td>
              <td class="nowrap" data-priority="3">
                <time>{r.time}</time>
              </td>
              <td class="col-actions">
                <div class="row-actions">
                  <button class="btn btn--sm" type="button">
                    {r.quick}
                  </button>
                  <span class="row-menu__wrap">
                    <button
                      class="btn btn--sm btn--icon row-menu__btn"
                      type="button"
                      aria-haspopup="menu"
                      aria-expanded={i === 0 ? 'true' : 'false'}
                      aria-label="更多操作"
                    >
                      <Icon name="more" size={20} />
                    </button>
                  </span>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2>「⋯」菜单（展开态）</h2>
    <div class="row-menu row-menu--static glass" role="menu" aria-label="操作：样张">
      <button class="row-menu__item" type="button" role="menuitem">
        取消置顶
      </button>
      <button class="row-menu__item" type="button" role="menuitem">
        取消精华
      </button>
      <button class="row-menu__item" type="button" role="menuitem">
        锁定
      </button>
      <button class="row-menu__item" type="button" role="menuitem">
        查看作者
      </button>
      <button class="row-menu__item row-menu__item--danger" type="button" role="menuitem">
        删除…
      </button>
    </div>

    <h2>数据表 · 加载（骨架）</h2>
    <div class="table-wrap">
      <table class="data-table" data-cards data-truncate-ok>
        <caption class="visually-hidden">加载中（样张）</caption>
        <tbody>
          {[0, 1, 2].map(() => (
            <tr class="no-check table-skel" aria-hidden="true">
              <td colspan="8">
                <span class="skeleton skeleton--icon"></span>
                <span class="table-skel__lines">
                  <span class="skeleton skeleton--title"></span>
                  <span class="skeleton skeleton--text"></span>
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2>数据表 · 空 / 筛选后空 / 错误</h2>
    <div class="kit-admin__states">
      <div class="table-wrap">
        <div class="empty-state empty-state--admin">
          <Icon name="inbox" size={32} />
          <p class="empty-state__title">还没有主题</p>
          <p class="empty-state__text">用户发布后会出现在这里。</p>
        </div>
      </div>
      <div class="table-wrap">
        <div class="empty-state empty-state--admin">
          <Icon name="search" size={32} />
          <p class="empty-state__title">没有符合条件的内容</p>
          <p class="empty-state__text">换个关键词，或清除筛选条件再看看。</p>
          <button class="btn btn--sm" type="button">
            清除筛选
          </button>
        </div>
      </div>
      <div class="table-wrap">
        <div class="error-bar error-bar--admin" role="alert">
          <Icon name="alert-circle" />
          <span class="error-bar__text">网络连接失败，请检查网络后重试。</span>
          <button class="btn btn--sm" type="button">
            重试
          </button>
        </div>
      </div>
    </div>

    <h2>权限状态卡</h2>
    <div class="kit-admin__states">
      <div class="state-card">
        <Icon name="user" class="state-card__icon" />
        <p class="state-card__title">管理后台需要登录。</p>
        <p class="state-card__text">请用版主或管理员账号登录，登录后会回到这一页。</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="#t">
            登录
          </a>
        </div>
      </div>
      <div class="state-card">
        <Icon name="alert-circle" class="state-card__icon" />
        <p class="state-card__title">这个页面仅管理员可用。</p>
        <p class="state-card__text">如需权限，请联系站长。权限由数据库再次校验，界面隐藏只为体验。</p>
        <div class="btn-row">
          <a class="btn" href="#t">
            返回首页
          </a>
        </div>
      </div>
    </div>

    <h2>提示条与危险确认</h2>
    <div class="kit-admin__states">
      <p class="toast toast--ok kit-admin__toast">已处理 2 条。</p>
      <p class="toast toast--error kit-admin__toast">操作失败：没有权限，或内容已被删除</p>
      <div class="sheet kit-admin__sheet" role="group" aria-label="危险确认（样张）">
        <p>永久删除这条主题「广告：低价出售游戏账号」？主题下的回复会一并删除。此操作不可撤销。</p>
        <div class="btn-row sheet__actions">
          <button class="btn" type="button">
            取消
          </button>
          <button class="btn btn--danger" type="button">
            删除
          </button>
        </div>
      </div>
    </div>
  </div>
</Base>
