---
/**
 * /_kit/ 组件目录（T9.2，DESIGN-QA Q2 / Q15）：token 样张 + 每种卡片 × 最短 / 典型 / 最长内容。
 * 只在非生产构建输出（VERCEL_ENV !== 'production'）；noindex、不进 sitemap / 搜索。
 * Astro 会忽略下划线开头的页面文件，所以用动态段 [kit] 只生成 `_kit` 这一条路径。
 * `.is-hover` / `.is-focus` / `.is-pressed` 等状态调试类由 T9.7 组件实现后在这里逐一展示。
 */
import Base from '@/layouts/Base.astro';
import PageHead from '@/components/PageHead.astro';
import AppCard from '@/components/AppCard.astro';
import ToolCard from '@/components/ai/ToolCard.astro';
import VideoCard from '@/components/videos/VideoCard.astro';
import GameCard from '@/components/GameCard.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import AppIcon from '@/components/apps/AppIcon.astro';
import Status from '@/components/Status.astro';
import Segmented from '@/components/Segmented.astro';
import { getArticles, getCatalog, getGames, getTools, getVideos, toolItem, videoItem } from '@/lib/content';
import { tokens } from '@/lib/tokens';

export function getStaticPaths() {
  return process.env.VERCEL_ENV === 'production' ? [] : [{ params: { kit: '_kit' } }];
}

const byLen = <T,>(xs: T[], f: (x: T) => string) => {
  const s = [...xs].sort((a, b) => f(a).length - f(b).length);
  return [s[0], s[Math.floor(s.length / 2)], s[s.length - 1]];
};
const tools = byLen((await getTools()).map(toolItem), (t) => t.summary);
const apps = byLen(await getCatalog(), (a) => a.title + a.subtitle);
const videos = byLen((await getVideos()).map(videoItem), (v) => v.title);
const games = byLen(await getGames(), (g) => g.data.title);
const articles = byLen(await getArticles(), (a) => a.data.title);
const iconSrc = tools[1];

const colorRoles = Object.keys(tokens.color.light).filter((k) => !/^(elev|cover|icon-stroke|mono-)/.test(k));
const typeNames = Object.keys(tokens.scale);
const spaces = Object.entries(tokens.space).sort((a, b) => a[1] - b[1]);
const radii = ['xs', 'sm', 'md', 'lg', 'pill'];
const elevs = ['elev-0', 'elev-1', 'elev-2'];
// 样张用生成的类而不是 style 属性（html-validate no-inline-style）
const kitCss = [
  ...colorRoles.map((r) => `.kit-c-${r}{background:var(--c-${r})}`),
  ...spaces.map(([k]) => `.kit-s-${k}{width:var(--space-${k})}`),
  ...radii.map((r) => `.kit-r-${r}{border-radius:var(--radius-${r})}`),
  ...elevs.map((e) => `.kit-${e}{box-shadow:var(--${e})}`),
].join('');
---

<Base
  title="组件目录"
  description="AZ Studio 设计系统组件目录（开发用）"
  noindex
  crumbs={[
    { name: '首页', path: '/' },
    { name: '组件目录', path: '/_kit/' },
  ]}
>
  <style slot="head" is:inline set:html={kitCss}></style>
  <div class="shell page kit">
    <PageHead eyebrow="设计系统" title="组件目录" lede="token 样张与卡片在最短、典型、最长内容下的样子。" />

    <section class="kit__section" aria-labelledby="kit-type">
      <h2 id="kit-type">字阶</h2>
      <ul role="list" class="kit__list">
        {typeNames.map((n) => (
          <li>
            <span class={`t-${n}`}>{n} · AZ Studio 应用与 AI 工具</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="kit__section" aria-labelledby="kit-color">
      <h2 id="kit-color">色彩角色</h2>
      <ul role="list" class="kit__swatches">
        {colorRoles.map((r) => (
          <li>
            <span class={`kit__swatch kit-c-${r}`} />
            <code>--c-{r}</code>
          </li>
        ))}
      </ul>
    </section>

    <section class="kit__section" aria-labelledby="kit-space">
      <h2 id="kit-space">间距、圆角、阴影</h2>
      <ul role="list" class="kit__list">
        {spaces.map(([k, v]) => (
          <li class="kit__row">
            <code>--space-{k}</code>
            <span class={`kit__bar kit-s-${k}`} />
            <span class="t-meta">{v}px</span>
          </li>
        ))}
      </ul>
      <ul role="list" class="kit__swatches">
        {radii.map((r) => (
          <li>
            <span class={`kit__swatch kit-r-${r}`} />
            <code>--radius-{r}</code>
          </li>
        ))}
        {elevs.map((e) => (
          <li>
            <span class={`kit__swatch kit__swatch--surface kit-${e}`} />
            <code>--{e}</code>
          </li>
        ))}
      </ul>
    </section>

    <section class="kit__section" aria-labelledby="kit-controls">
      <h2 id="kit-controls">按钮、徽标、分段控件</h2>
      <div class="btn-row">
        <button type="button" class="btn btn--primary">
          获取
        </button>
        <button type="button" class="btn">
          访问官网
        </button>
        <button type="button" class="btn" disabled>
          上线时通知我
        </button>
        <button type="button" class="btn btn--danger">
          删除
        </button>
      </div>
      <div class="btn-row">
        <Status text="已发布" />
        <Status cls="review" text="审核中" />
        <Status cls="stable" text="稳定" />
        <Status cls="experiment" text="实验" />
        <span class="badge">即将推出</span>
      </div>
      <Segmented
        label="示例分段"
        items={[
          { href: '/_kit/', label: '全部', current: true },
          { href: '/_kit/#kit-type', label: '应用' },
          { href: '/_kit/#kit-color', label: 'AI 工具' },
        ]}
      />
    </section>

    <section class="kit__section" aria-labelledby="kit-icons">
      <h2 id="kit-icons">应用图标</h2>
      <div class="kit__icons">
        {(['xs', 'sm', 'md', 'lg', 'xl'] as const).map((s) => (
          <AppIcon src={iconSrc.iconSrc} alt="" size={s} variants={iconSrc.iconVariants} />
        ))}
      </div>
    </section>

    <section class="kit__section" aria-labelledby="kit-tools">
      <h2 id="kit-tools">AI 工具卡（最短 / 典型 / 最长简介）</h2>
      <div class="grid">
        {tools.map((t) => (
          <ToolCard item={t} headingLevel="h3" />
        ))}
      </div>
    </section>

    <section class="kit__section" aria-labelledby="kit-apps">
      <h2 id="kit-apps">应用卡</h2>
      <div class="grid">
        {apps.map((a) => (
          <AppCard item={a} headingLevel="h3" />
        ))}
      </div>
    </section>

    <section class="kit__section" aria-labelledby="kit-media">
      <h2 id="kit-media">媒体卡（视频 / 游戏 / 文章）</h2>
      <div class="grid">
        {videos.map((v) => (
          <VideoCard item={v} headingLevel="h3" />
        ))}
      </div>
      <div class="grid">
        {games.map((g) => (
          <GameCard game={g} headingLevel="h3" />
        ))}
      </div>
      <div class="grid">
        {articles.map((a) => (
          <ArticleCard article={a} headingLevel="h3" />
        ))}
      </div>
    </section>
  </div>
</Base>

<style>
  .kit__section {
    margin-top: var(--space-12);
    display: grid;
    gap: var(--space-4);
  }
  .kit__list {
    display: grid;
    gap: var(--space-2);
  }
  .kit__row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .kit__bar {
    display: inline-block;
    height: var(--space-3);
    background: var(--c-accent);
  }
  .kit__swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: var(--space-4);
  }
  .kit__swatches li {
    display: grid;
    gap: var(--space-2);
  }
  .kit__swatch {
    display: block;
    height: var(--space-12);
    border-radius: var(--radius-sm);
    box-shadow: var(--elev-0);
  }
  .kit__swatch--surface {
    background: var(--c-surface);
  }
  .kit__icons {
    display: flex;
    align-items: end;
    gap: var(--space-6);
  }
  code {
    font-size: var(--fs-meta);
  }
</style>
