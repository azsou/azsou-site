---
// Local development fixture only. These files are a proposal, not canonical article routes.
import { listPublishedArticles, validPublicArticleSlug } from '@/lib/data/published-article';
import { classifySupabaseUrl, supabaseConfig } from '@/lib/supabase-config';

export const prerender = false;

const limit = 20;
const input = Astro.url.searchParams.getAll('after');
const cursor = input.length === 0 ? null : input.length === 1 ? (input[0] ?? '') : '';
let status = 200;
let articles: Awaited<ReturnType<typeof listPublishedArticles>> = [];
const localHost = ['127.0.0.1', 'localhost', '[::1]'].includes(Astro.url.hostname);
if (!import.meta.env.DEV || !localHost) {
  status = 404;
} else if (cursor !== null && !validPublicArticleSlug(cursor)) {
  status = 400;
} else {
  try {
    const config = supabaseConfig();
    if (classifySupabaseUrl(config.url)?.target !== 'local') status = 503;
    else articles = await listPublishedArticles(config, cursor, limit);
  } catch {
    status = 503;
  }
}
Astro.response.status = status;
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
const after = articles.length === limit ? articles[articles.length - 1]?.slug : null;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>已发布文章（本机试点）</title>
  </head>
  <body>
    <main>
      <h1>已发布文章（本机试点）</h1>
      {status === 404 ? (
        <p>未找到页面。</p>
      ) : status === 400 ? (
        <p>分页标识无效。</p>
      ) : status === 503 ? (
        <p role="alert">暂时无法读取文章列表。</p>
      ) : (
        <>
          {articles.length ? (
            <ul>
              {articles.map((row) => (
                <li>
                  <a href={`/articles/live/${row.slug}/`}>{row.title}</a>
                </li>
              ))}
            </ul>
          ) : (
            <p>本页没有已发布文章。</p>
          )}
          {after && <a href={`/articles/live/?after=${encodeURIComponent(after)}`}>查看下一页</a>}
        </>
      )}
    </main>
  </body>
</html>
