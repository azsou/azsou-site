---
import { artSrc } from '@/lib/art';
import Base from '@/layouts/Base.astro';
import AppIcon from '@/components/apps/AppIcon.astro';
import Art from '@/components/Art.astro';
import Comments from '@/components/Comments.astro';
import { getApps, getArticles, forum, type Article } from '@/lib/content';
import { url } from '@/lib/routes';
import { ogFor } from '@/lib/og-routes';
import { article as articleLd } from '@/lib/seo';
import { excerpt } from '@/lib/escape';
import { tagName } from '@/lib/tags';
import { toDate } from '@/lib/dates';
import AdSlot from '@/components/ads/AdSlot.astro';
import Disclosure from '@/components/Disclosure.astro';
import SponsorSlot from '@/components/SponsorSlot.astro';
import { splitForInArticleAd } from '@/lib/ads';
import { countSponsored, markSponsored } from '@/lib/sponsored';

export async function getStaticPaths() {
  const list = await getArticles();
  return list.map((a, i) => ({
    params: { slug: a.id },
    props: { a, newer: list[i - 1] ?? null, older: list[i + 1] ?? null },
  }));
}
const { a, newer, older } = Astro.props as { a: Article; newer: Article | null; older: Article | null };
const d = a.data;
// 正文是迁移来的可信 HTML（仓库内容），原样输出，不经 Markdown 二次处理
// 联盟 / 赞助链接统一加 rel="sponsored nofollow noopener"（T8.7）
const bodyHtml = markSponsored(a.body ?? '', d.sponsoredLinks);
const path = url.article(a.id);
const description = d.description ?? excerpt(bodyHtml, 120);
const disclosure = d.disclosure ?? (countSponsored(bodyHtml) > 0 ? { type: 'affiliate' as const } : null);
// 文内广告位（T8.3）：只在长文（≥ 1500 字）的第 2 个二级标题前插入；广告关闭时 AdSlot 不输出任何内容
const parts = splitForInArticleAd(bodyHtml);
const thread = d.forumThread ? forum.seeds.find((t) => t.id === d.forumThread) : null;
const apps = (await getApps()).filter((x) => x.data.relatedArticles.includes(a.id));
// 二级标题 id 固定为 a-sec-N，与 frontmatter.toc 一一对应（单元测试保证）
const toc = d.toc.map((text, i) => ({ text, slug: `a-sec-${i + 1}` }));
---

<Base
  searchType="article"
  preloadImage={d.art ? artSrc(d.art) : undefined}
  title={d.title}
  description={description}
  type="article"
  image={ogFor('article', a.id)}
  imageAlt={d.title}
  published={toDate(d.date).toISOString()}
  modified={toDate(d.lastChecked).toISOString()}
  crumbs={[
    { name: '首页', path: '/' },
    { name: '文章', path: '/articles/' },
    { name: d.category, path: url.tag(d.tags[0]) },
    { name: d.title, path },
  ]}
  schema={[
    articleLd({
      title: d.title,
      description,
      path,
      date: d.date,
      modified: d.lastChecked,
      image: d.ogImage,
      section: d.category,
      keywords: d.tags.map(tagName),
    }),
  ]}
>
  <div class="split">
    <article>
      <header class="page-head">
        <p class="eyebrow">
          {d.category} · {d.badge}
        </p>
        <h1>{d.title}</h1>
        <div class="article-meta">
          <span>{d.author}</span>
          <time datetime={d.date}>{d.date}</time>
          <span>{d.readingMinutes} 分钟</span>
          <span>
            最后核对：<time datetime={d.lastChecked}>{d.lastChecked}</time>
          </span>
        </div>
      </header>
      {d.art && (
        <div class="hero-media hero-media--2x1">
          <Art slot={d.art} eager />
        </div>
      )}
      {disclosure && <Disclosure {...disclosure} />}
      <div class="prose">
        {parts ? (
          <>
            <Fragment set:html={parts[0]} />
            <AdSlot placement="article" />
            <Fragment set:html={parts[1]} />
          </>
        ) : (
          <Fragment set:html={bodyHtml} />
        )}
      </div>
      <p class="mt-8">
        {d.tags.map((t) => (
          <a class="badge" href={url.tag(t)}>
            #{tagName(t)}
          </a>
        ))}
      </p>
      {thread && (
        <p class="notice notice--info mt-4">
          这篇文章有对应的论坛讨论串：<a href={url.forumThread(thread.id)}>{thread.title}</a>
        </p>
      )}
      <nav class="pager" aria-label="上下篇导航">
        {newer && (
          <a href={url.article(newer.id)} rel="prev">
            <small>上一篇（较新）</small>
            {newer.data.title}
          </a>
        )}
        {older && (
          <a href={url.article(older.id)} rel="next">
            <small>下一篇（较早）</small>
            {older.data.title}
          </a>
        )}
      </nav>
      <Comments pageKey={`article:${a.id}`} />
    </article>
    <aside aria-label="文章侧栏">
      {toc.length > 0 && (
        <nav class="panel toc" aria-labelledby="h-toc">
          <h2 id="h-toc">本文目录</h2>
          <ol>
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}
      {apps.length > 0 && (
        <section class="panel">
          <h2>关联项目</h2>
          <ul class="list-reset" role="list">
            {apps.map((x) => (
              <li>
                <a class="list-row" href={url.app(x.id)}>
                  <AppIcon src={x.data.icon.src} variants={x.data.icon.variants} alt="" size="sm" eager />
                  <span class="list-row__main">
                    {x.data.title}
                    <br />
                    <span class="list-row__sub">{x.data.status}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
      <SponsorSlot />
      {parts && <AdSlot placement="sidebar" />}
    </aside>
  </div>
</Base>
