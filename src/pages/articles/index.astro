---
import Base from '@/layouts/Base.astro';
import PageHead from '@/components/PageHead.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import Segmented from '@/components/Segmented.astro';
import { getArticles } from '@/lib/content';
import { TAGS } from '@/lib/tags';
import { url } from '@/lib/routes';
const articles = await getArticles();
const used = [...new Set(articles.flatMap((a) => a.data.tags))];
---

<Base
  title="原创技术文章"
  description="真实项目的开发实践、实测与复盘：FableMotion、浏览器扩展、游戏系统与单文件工作流。每篇标注最后核对日期。"
  crumbs={[
    { name: '首页', path: '/' },
    { name: '文章', path: '/articles/' },
  ]}
>
  <PageHead
    eyebrow="文章"
    title="原创技术文章"
    lede="真实项目、实测结论和可复现教程。每篇都标注最后核对日期。"
  >
    <p>
      <a href="/articles/rss.xml">订阅 RSS</a> · <a href={url.archive()}>按月归档</a>
    </p>
  </PageHead>
  <Segmented
    label="按标签筛选"
    items={[
      { href: url.articles(), label: '全部', current: true },
      ...used.map((t) => ({ href: url.tag(t), label: TAGS[t]?.name ?? t })),
    ]}
  />
  <div class="grid grid--wide">
    {articles.map((a) => (
      <ArticleCard article={a} />
    ))}
  </div>
</Base>
