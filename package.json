{
  "name": "azsou-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "AZ Studio · azsou.com v2（Astro 静态站）",
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/pagefind.mjs",
    "check": "astro check",
    "serve": "node scripts/serve.mjs",
    "migrate:content": "node scripts/migrate-content.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "npm run test:unit && npm run test:links && npm run test:html && npm run test:ld && npm run test:e2e",
    "test:unit": "vitest run",
    "test:links": "node scripts/check-links.mjs",
    "test:html": "html-validate \"dist/client/**/*.html\"",
    "test:ld": "vitest run -c vitest.built.config.ts",
    "test:e2e": "playwright test",
    "test:lhci": "lhci autorun --config=lighthouserc.cjs",
    "size": "node scripts/size-report.mjs",
    "test:csp": "node scripts/check-csp.mjs",
    "csp:update": "node scripts/check-csp.mjs --write",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "db:drill": "bash scripts/restore-drill.sh",
    "test:db": "vitest run -c vitest.db.config.ts",
    "db:local": "bash scripts/pg-local.sh start"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "3.6.0",
    "@astrojs/vercel": "^8.2.11",
    "astro": "^5.18.2",
    "dompurify": "^3.4.17",
    "nodemailer": "^7.0.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.0.0",
    "eslint-plugin-astro": "^3.2.1",
    "html-validate": "^11.17.0",
    "jsdom": "^26.1.0",
    "pagefind": "^1.5.2",
    "pg": "^8.23.1",
    "prettier": "^3.6.0",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.4"
  }
}
