{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/az-sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/og/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ],
  "rewrites": [
    { "source": "/((?!az-sw\\.js|og/|favicon\\.svg|manifest\\.webmanifest|robots\\.txt|sitemap\\.xml|rss\\.xml).*)", "destination": "/index.html" }
  ]
}
