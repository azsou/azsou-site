# 数据适配器：supabase（默认）| memory（离线/测试）
PUBLIC_DATA_ADAPTER=supabase
# 两个必须同时设置；没有默认值。本机开发只能填隔离测试项目 azsou-test 或本机栈（localhost / 127.0.0.1），填生产会构建失败（docs/DEPLOY.md「Supabase 连接配置」）
PUBLIC_SUPABASE_URL=https://ovvfwkmqlejcpatmfqcd.supabase.co
# 公开（publishable）key，可安全暴露在前端；权限由 RLS 决定。绝不要填 secret / service_role
PUBLIC_SUPABASE_KEY=sb_publishable_...
